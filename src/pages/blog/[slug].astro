---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import CTA from '../../components/CTA.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, related: posts.filter((p) => p.id !== post.id).slice(0, 2) } }));
}

const { post, related } = Astro.props as { post: CollectionEntry<'blog'>; related: CollectionEntry<'blog'>[] };
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
---

<Layout title={post.data.title} description={post.data.description} image={post.data.image}>
  <div id="read-progress" class="fixed left-0 top-0 z-[121] h-[3px] w-full origin-left scale-x-0 bg-signal"></div>

  <article>
    <header class="relative pb-12 pt-40 md:pt-52">
      <div class="wrap max-w-5xl">
        <a href="/blog/" class="eyebrow link-u mb-10 inline-block" data-reveal data-reveal-immediate data-label="Journal">← Journal</a>
        <div class="mb-8 flex flex-wrap items-center gap-4 font-mono text-[11px] uppercase tracking-[0.2em] text-mute" data-reveal data-reveal-immediate data-delay="0.1">
          <span class="rounded-full border border-white/15 px-3 py-1 text-paper">{post.data.category}</span>
          <time datetime={post.data.date.toISOString()}>{date}</time>
          <span>{post.data.readingTime} min read</span>
        </div>
        <h1 class="text-[clamp(2.4rem,5.6vw,5.5rem)] font-medium leading-[0.95] tracking-[-0.045em]" data-split="lines" data-split-immediate data-delay="0.1">
          {post.data.title}
        </h1>
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-paper/60" data-reveal data-reveal-immediate data-delay="0.4">{post.data.description}</p>
      </div>
    </header>

    <div class="wrap max-w-6xl">
      <div class="relative aspect-[21/9] overflow-hidden rounded-3xl" data-img-reveal data-reveal-immediate>
        <img src={post.data.image} alt="" class="h-full w-full object-cover" />
      </div>
    </div>

    <div class="wrap max-w-3xl py-20 md:py-28">
      <div class="prose-caltec" data-reveal>
        <Content />
      </div>
    </div>
  </article>

  <section class="border-t border-white/10 py-24">
    <div class="wrap">
      <p class="eyebrow eyebrow-dot mb-10">Keep reading</p>
      <div class="grid gap-6 md:grid-cols-2" data-stagger>
        {related.map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>

  <CTA />
</Layout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  gsap.to('#read-progress', { scaleX: 1, ease: 'none', scrollTrigger: { trigger: 'article', start: 'top top', end: 'bottom bottom', scrub: 0.2 } });
</script>
