---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Out of tolerance">
  <section class="relative flex min-h-[100svh] items-center overflow-hidden">
    <div class="grid-bg pointer-events-none absolute inset-0 opacity-60"></div>
    <div class="wrap relative">
      <p class="eyebrow eyebrow-dot mb-8" data-reveal data-reveal-immediate>Error · reading out of tolerance</p>
      <h1 class="font-mono text-[clamp(6rem,24vw,22rem)] font-light leading-[0.8] tracking-[-0.06em]" data-split="chars" data-split-immediate>
        404
      </h1>
      <p class="mt-8 max-w-lg text-xl text-paper/70" data-reveal data-reveal-immediate data-delay="0.3">This page drifted off the scale. Let’s get you back to a known reference.</p>
      <div class="mt-10 flex flex-wrap gap-3" data-reveal data-reveal-immediate data-delay="0.4">
        <a href="/" class="btn btn-primary" data-magnetic data-label="Home">Back to home</a>
        <a href="/services/" class="btn btn-ghost" data-magnetic data-label="Services">Browse services</a>
      </div>
    </div>
  </section>
</Layout>
