---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.astro';
import Clients from '../components/home/Clients.astro';
import Disciplines from '../components/home/Disciplines.astro';
import Industries from '../components/home/Industries.astro';
import Process from '../components/home/Process.astro';
import CTA from '../components/CTA.astro';
import PostCard from '../components/PostCard.astro';
import CertGallery from '../components/react/CertGallery';
import { loadCerts } from '../lib/certs';

const certs = await loadCerts();
const posts = (await getCollection('blog')).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
---

<Layout>
  <Hero />

  <!-- Statement -->
  <section class="relative py-28 md:py-44">
    <div class="wrap grid gap-10 lg:grid-cols-12">
      <p class="eyebrow eyebrow-dot lg:col-span-3">Since 2014</p>
      <div class="lg:col-span-9">
        <p class="text-[clamp(1.75rem,3.6vw,3.6rem)] font-medium leading-[1.08] tracking-[-0.035em]" data-scrub-words>
          CALTEC is a one-stop instrumentation partner. We install, service and calibrate the instruments that measure temperature, pressure, flow, level, conductivity and humidity — so your plant can prove every reading it relies on.
        </p>
        <div class="mt-14 grid gap-10 sm:grid-cols-3" data-stagger>
          {
            [
              ['Audit-aware', 'Documentation organised around your quality workflow.'],
              ['Accountable', 'One team across laboratory and field support.'],
              ['Scope first', 'Requirements clarified before promises are made.'],
            ].map(([t, d]) => (
              <div class="border-t border-white/15 pt-5">
                <p class="text-lg font-medium">{t}</p>
                <p class="mt-2 text-[15px] leading-relaxed text-paper/60">{d}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <Clients />
  <Disciplines />

  <!-- Field / lab split image -->
  <section class="relative overflow-hidden">
    <div class="wrap grid items-center gap-12 py-28 md:py-40 lg:grid-cols-12">
      <div class="relative lg:col-span-7">
        <div class="relative aspect-[4/3] overflow-hidden rounded-3xl" data-img-reveal>
          <img src="/images/plant-wide.jpg" alt="Process plant with illuminated towers and pipe racks at night" loading="lazy" class="h-full w-full object-cover" />
          <div class="absolute inset-0 bg-gradient-to-t from-ink/70 to-transparent"></div>
          <div class="absolute bottom-5 left-5 right-5 flex flex-wrap items-center justify-between gap-3 font-mono text-[11px] uppercase tracking-[0.2em]">
            <span class="rounded-full bg-ink/70 px-3 py-1.5 backdrop-blur">Field ready</span>
            <span class="rounded-full bg-ink/70 px-3 py-1.5 backdrop-blur">Karachi · Nationwide support</span>
          </div>
        </div>
        <div class="absolute -right-4 -top-8 hidden rounded-2xl border border-white/10 bg-ink-2/90 p-5 backdrop-blur md:block lg:-right-10" data-reveal="scale" data-parallax="0.3">
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-mute">Hydraulic range</p>
          <p class="mt-1 font-mono text-4xl tabular-nums"><span data-counter="400">400</span><span class="text-lg text-mute"> bar</span></p>
        </div>
      </div>
      <div class="lg:col-span-5 lg:pl-8">
        <p class="eyebrow eyebrow-dot mb-5">Laboratory + on-site</p>
        <h2 class="text-huge font-medium leading-[0.95] tracking-[-0.045em]" data-split="lines">
          The lab standard, <span class="serif-i text-paper/60">brought to</span> your process.
        </h2>
        <p class="mt-8 text-lg leading-relaxed text-paper/60" data-reveal>
          Most calibration happens at our clients' sites, so equipment returns to service fast. When repair is needed, our Karachi workshop is fully equipped to handle it — with a clear record behind every job.
        </p>
        <ul class="mt-8 space-y-3" data-stagger>
          {
            ['Industrial instrumentation & process control', 'All types of temperature monitoring', 'Pressure gauges & transmitters', 'Conductivity & humidity instruments', 'pH & conductivity instruments'].map((t) => (
              <li class="flex items-center gap-4 border-b border-white/10 pb-3 text-[15px]">
                <span class="h-px w-5 bg-signal" />
                {t}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Industries />
  <Process />

  <!-- Certification -->
  <section class="relative overflow-hidden py-28 md:py-40">
    <div class="wrap">
      <div class="mb-16 grid gap-8 md:grid-cols-12">
        <div class="md:col-span-7">
          <p class="eyebrow eyebrow-dot mb-5">Assurance, made visible</p>
          <h2 class="text-huge font-medium leading-[0.95] tracking-[-0.045em]" data-split="lines">
            Certified systems behind <span class="serif-i text-paper/60">every</span> service.
          </h2>
        </div>
        <div class="self-end md:col-span-4 md:col-start-9" data-reveal>
          <p class="text-lg leading-relaxed text-paper/60">Integrated management certifications support consistent quality, environmental responsibility and occupational health & safety.</p>
          <a href="/certification/" class="btn btn-ghost mt-6" data-magnetic data-label="Certification">View certificates</a>
        </div>
      </div>
      <CertGallery client:visible certs={certs} />
    </div>
  </section>

  <!-- Journal -->
  <section class="border-t border-white/10 py-28 md:py-36">
    <div class="wrap">
      <div class="mb-14 flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow eyebrow-dot mb-5">Journal</p>
          <h2 class="text-huge font-medium leading-[0.95] tracking-[-0.045em]" data-split="lines">Notes from the field.</h2>
        </div>
        <a href="/blog/" class="btn btn-ghost" data-magnetic data-label="Journal">All articles</a>
      </div>
      <div class="grid gap-6 md:grid-cols-3" data-stagger="0.1">
        {posts.map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>

  <CTA />
</Layout>
