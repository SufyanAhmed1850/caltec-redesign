---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import { site, industries, clients, instrumentCount } from '../data/site';
const years = new Date().getFullYear() - site.founded;

const timeline = [
  { y: '2014', t: 'Founded in Karachi', d: 'CALTEC Instrument Services Co is established to offer single-stop installation, servicing and calibration.' },
  { y: '2020', t: 'CalSoft & digital records', d: 'Our business profile introduces CalSoft calibration management software and structured certificate formats.' },
  { y: '2023', t: 'Integrated ISO certification', d: 'Management systems certified to ISO 9001, ISO 14001 and ISO 45001.' },
  { y: 'Now', t: `${clients.length}+ organisations`, d: 'Supporting pharma, textiles, automotive, food, energy and healthcare nationwide.' },
];
---

<Layout title="About" description="Since 2014, CALTEC Instrument Services has provided on-site installation, repair and calibration for industrial instruments across Pakistan.">
  <PageHero
    eyebrow="About CALTEC"
    title="Accuracy is our"
    accent="whole business."
    lede="A specialised Karachi company providing on-site installation, repair and calibration for temperature, pressure, flow, level, conductivity and humidity instruments — since 2014."
    image="/images/plant-wide.jpg"
  />

  <section class="py-20 md:py-32">
    <div class="wrap grid gap-14 lg:grid-cols-12">
      <p class="eyebrow eyebrow-dot lg:col-span-3">Our story</p>
      <div class="lg:col-span-9">
        <p class="text-[clamp(1.6rem,3.2vw,3rem)] font-medium leading-[1.12] tracking-[-0.03em]" data-scrub-words>
          We started with a simple priority: give hospitals, pharmaceutical plants, textile mills, cement works, oil & gas operators and food processors one dependable partner for every instrument they rely on.
        </p>
        <div class="mt-14 grid gap-10 text-lg leading-relaxed text-paper/65 md:grid-cols-2" data-stagger>
          <p>Our engineers learned their trade inside industry — in pharmaceutical and medical manufacturing, paper mills, power plants, petrochemical sites, food processors, dairies and breweries. They bring that operating context to every job.</p>
          <p>We work to the highest standards of quality management so clients can meet strict regulations and pass every audit. Each certificate lists the information, procedures and findings behind the result — nothing hidden, nothing assumed.</p>
          <p>From installing control systems to upgrading them, every plant control and monitoring system benefits from regular service — and calibration sits at the heart of that routine.</p>
          <p>Alongside calibration and repair, CALTEC supplies instrumentation — including a selection of quality used instruments — and installs and operates temperature monitoring systems.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Numbers -->
  <section class="border-y border-white/10 bg-ink-2">
    <div class="wrap grid grid-cols-2 lg:grid-cols-4">
      {
        [
          { v: years, l: 'Years of service', s: '' },
          { v: clients.length, l: 'Client organisations', s: '+' },
          { v: instrumentCount, l: 'Instrument types', s: '' },
          { v: 3, l: 'ISO certifications', s: '' },
        ].map((n, i) => (
          <div class:list={['border-white/10 py-12 md:py-16', i % 2 === 1 && 'border-l pl-6 md:pl-10', i >= 2 && 'border-t lg:border-t-0', i === 2 && 'lg:border-l lg:pl-10']}>
            <p class="font-mono text-[clamp(3rem,6vw,5.5rem)] font-light leading-none tabular-nums tracking-tight">
              <span data-counter={n.v}>{n.v}</span>
              <span class="text-signal">{n.s}</span>
            </p>
            <p class="mt-4 text-xs uppercase tracking-[0.2em] text-mute">{n.l}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-24 md:py-36" data-draw-trigger>
    <div class="wrap grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-32">
          <p class="eyebrow eyebrow-dot mb-5">Milestones</p>
          <h2 class="text-huge font-medium leading-[0.95] tracking-[-0.045em]" data-split="lines">A decade of <span class="serif-i text-paper/60">measured</span> growth.</h2>
        </div>
      </div>
      <ol class="relative lg:col-span-8">
        <svg class="absolute left-[7px] top-2 h-[calc(100%-1rem)] w-[2px] overflow-visible" preserveAspectRatio="none" viewBox="0 0 2 100" aria-hidden="true">
          <line x1="1" y1="0" x2="1" y2="100" stroke="rgb(255 255 255 / .12)" stroke-width="2" />
          <path data-draw d="M1 0 V100" stroke="#e4262c" stroke-width="2" fill="none" />
        </svg>
        {
          timeline.map((m) => (
            <li class="relative pb-14 pl-12 last:pb-0" data-reveal>
              <span class="absolute left-0 top-1.5 h-4 w-4 rounded-full border-2 border-signal bg-ink" />
              <p class="font-mono text-sm text-signal">{m.y}</p>
              <p class="mt-2 text-3xl font-medium tracking-[-0.03em] md:text-4xl">{m.t}</p>
              <p class="mt-3 max-w-xl text-lg leading-relaxed text-paper/60">{m.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Industries -->
  <section class="overflow-hidden border-t border-white/10 py-24 md:py-32">
    <div class="wrap mb-12">
      <p class="eyebrow eyebrow-dot">Industries we serve</p>
    </div>
    <div class="flex whitespace-nowrap">
      <div data-marquee data-speed="60" class="flex shrink-0 items-center gap-10 pr-10 text-[clamp(2.5rem,7vw,7rem)] font-medium tracking-[-0.045em]">
        {[...industries, ...industries].map((ind, i) => (
          <>
            <span class:list={[i % 2 ? 'serif-i font-normal text-paper/50' : '']}>{ind.name}</span>
            <span class="h-3 w-3 shrink-0 rounded-full bg-signal" />
          </>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-24 md:pb-36">
    <div class="wrap">
      <div class="grid overflow-hidden rounded-3xl border border-white/10 md:grid-cols-2">
        <div class="relative min-h-[320px]" data-img-reveal>
          <img src="/images/refinery-night.jpg" alt="Industrial facility at night" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
        </div>
        <div class="flex flex-col justify-between gap-10 bg-ink-2 p-8 md:p-12">
          <div>
            <p class="eyebrow mb-5">Give us a call</p>
            <p class="text-3xl font-medium leading-tight tracking-[-0.03em] md:text-4xl">Have a requirement? We’re always happy to talk it through.</p>
          </div>
          <div class="space-y-2 text-lg">
            <a class="link-u block" href={site.phones.mobile.href}>{site.phones.mobile.label}</a>
            <a class="link-u block text-paper/70" href={`mailto:${site.emails.info}`}>{site.emails.info}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</Layout>
