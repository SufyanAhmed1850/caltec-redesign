---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CTA from '../components/CTA.astro';
import Icon from '../components/Icon.astro';
import CertGallery from '../components/react/CertGallery';
import { loadCerts } from '../lib/certs';
const certs = await loadCerts();
---

<Layout title="Certification" description="CALTEC Instrument Services holds ISO 9001, ISO 14001 and ISO 45001 management system certifications.">
  <PageHero
    eyebrow="Certification"
    title="Assurance,"
    accent="made visible."
    lede="Integrated management system certifications that stand behind every calibration, inspection and validation we deliver."
  />

  <section class="pb-24 md:pb-32">
    <div class="wrap">
      <CertGallery client:load certs={certs} />
    </div>
  </section>

  <section class="border-t border-white/10 bg-ink-2 py-24 md:py-32">
    <div class="wrap grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow eyebrow-dot mb-5">What it means for you</p>
        <h2 class="text-huge font-medium leading-[0.95] tracking-[-0.045em]" data-split="lines">Certificates your <span class="serif-i text-paper/60">auditor</span> will accept.</h2>
      </div>
      <div class="grid gap-px overflow-hidden rounded-3xl border border-white/10 bg-white/10 sm:grid-cols-2 lg:col-span-7" data-stagger>
        {
          [
            ['Traceability', 'Reference standards with an unbroken calibration chain.'],
            ['Full records', 'Procedure, conditions, as-found and as-left readings on every certificate.'],
            ['Controlled process', 'Documented methods reviewed under our quality management system.'],
            ['Safe on site', 'ISO 45001 practices protect your people and ours during field work.'],
          ].map(([t, d]) => (
            <div class="bg-ink-2 p-7">
              <Icon name="check" class="h-5 w-5 text-signal" />
              <p class="mt-5 text-xl font-medium">{t}</p>
              <p class="mt-2 text-[15px] leading-relaxed text-paper/60">{d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTA />
</Layout>
