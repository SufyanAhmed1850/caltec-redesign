---
import type { CollectionEntry } from 'astro:content';
interface Props {
  post: CollectionEntry<'blog'>;
  large?: boolean;
}
const { post, large = false } = Astro.props;
const date = post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---

<a href={`/blog/${post.id}/`} data-cursor="Read" data-label="Journal" class="group flex flex-col">
  <div class:list={['relative overflow-hidden rounded-2xl bg-ink-2', large ? 'aspect-[16/9]' : 'aspect-[4/3]']}>
    <img
      src={post.data.image}
      alt=""
      loading="lazy"
      class="h-full w-full object-cover opacity-80 transition duration-[1.2s] ease-[var(--ease-out-expo)] group-hover:scale-105 group-hover:opacity-100"
    />
    <span class="absolute left-4 top-4 rounded-full bg-ink/70 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.2em] backdrop-blur">{post.data.category}</span>
  </div>
  <div class="mt-5 flex items-center gap-3 font-mono text-[11px] uppercase tracking-[0.18em] text-mute">
    <time datetime={post.data.date.toISOString()}>{date}</time>
    <span class="h-px w-4 bg-white/20"></span>
    <span>{post.data.readingTime} min read</span>
  </div>
  <h3 class:list={['mt-3 font-medium leading-tight tracking-[-0.025em] transition-colors group-hover:text-paper', large ? 'text-3xl md:text-4xl' : 'text-xl md:text-2xl']}>
    <span class="bg-[linear-gradient(currentColor,currentColor)] bg-[length:0_1px] bg-left-bottom bg-no-repeat transition-[background-size] duration-700 group-hover:bg-[length:100%_1px]">{post.data.title}</span>
  </h3>
  {large && <p class="mt-3 max-w-xl text-paper/60">{post.data.description}</p>}
</a>
