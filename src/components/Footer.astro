---
import { services, site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden border-t border-white/10 bg-ink pt-24">
  <div class="grid-bg pointer-events-none absolute inset-0 opacity-50 [mask-image:linear-gradient(to_bottom,black,transparent)]"></div>

  <div class="wrap relative">
    <div class="grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow eyebrow-dot mb-6">Calibration · instrumentation · validation</p>
        <h2 class="text-huge font-medium leading-[0.95] tracking-[-0.045em]" data-split="lines">
          Reliable measurements. <span class="serif-i text-paper/60">Confident</span> decisions.
        </h2>
        <a href="/enquiry/" data-magnetic class="btn btn-primary mt-10" data-label="Enquiry">
          Start an enquiry
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 11 11 3M5 3h6v6" stroke="currentColor" stroke-width="1.5" /></svg>
        </a>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3 lg:col-span-7" data-stagger>
        <div>
          <p class="eyebrow mb-5">Company</p>
          <ul class="space-y-2.5 text-[15px] text-paper/70">
            <li><a class="link-u hover:text-paper" href="/about/">About CALTEC</a></li>
            <li><a class="link-u hover:text-paper" href="/business-profile/">Business profile</a></li>
            <li><a class="link-u hover:text-paper" href="/certification/">Certifications</a></li>
            <li><a class="link-u hover:text-paper" href="/blog/">Journal</a></li>
            <li><a class="link-u hover:text-paper" href="/contact-us/">Contact</a></li>
            <li><a class="link-u hover:text-paper" href="/enquiry/">Enquiry</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-5">Services</p>
          <ul class="space-y-2.5 text-[15px] text-paper/70">
            {services.map((s) => <li><a class="link-u hover:text-paper" href={`/${s.slug}/`}>{s.short}</a></li>)}
          </ul>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <p class="eyebrow mb-5">Karachi office</p>
          <address class="space-y-1 text-[15px] not-italic leading-relaxed text-paper/70">
            {site.address.lines.map((l) => <span class="block">{l}</span>)}
          </address>
          <ul class="mt-6 space-y-1.5 text-[15px]">
            <li><a class="link-u" href={site.phones.mobile.href}>{site.phones.mobile.label}</a></li>
            <li><a class="link-u text-paper/70" href={site.phones.landline.href}>{site.phones.landline.label}</a></li>
            <li><a class="link-u text-paper/70" href={`mailto:${site.emails.info}`}>{site.emails.info}</a></li>
            <li><a class="link-u text-paper/70" href={`mailto:${site.emails.sales}`}>{site.emails.sales}</a></li>
          </ul>
          <div class="mt-6 flex gap-2">
            <a href={site.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="grid h-10 w-10 place-items-center rounded-full border border-white/15 transition hover:bg-paper hover:text-ink">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
            </a>
            <a href={site.phones.whatsapp.href} target="_blank" rel="noopener" aria-label="WhatsApp" class="grid h-10 w-10 place-items-center rounded-full border border-white/15 transition hover:bg-paper hover:text-ink">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.4-1.47-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.3 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.43 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.9c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.16-3.48-8.41"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-24 flex flex-col-reverse items-start justify-between gap-4 border-t border-white/10 py-6 font-mono text-[11px] uppercase tracking-[0.18em] text-mute sm:flex-row sm:items-center">
      <p>© {year} {site.name}</p>
      <div class="flex gap-6">
        <a href="/privacy-policy/" class="link-u hover:text-paper">Privacy</a>
        <a href="#main" class="link-u hover:text-paper" onclick="window.lenis ? (window.lenis.scrollTo(0), event.preventDefault()) : null">Back to top ↑</a>
      </div>
    </div>
  </div>

  <div class="relative select-none overflow-hidden" aria-hidden="true">
    <div class="ticks h-6 w-full opacity-60"></div>
    <p data-footer-mark class="whitespace-nowrap text-center text-[25.5vw] font-semibold leading-[0.9] tracking-[-0.07em] text-paper">
      CALTEC
    </p>
  </div>
</footer>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const mark = document.querySelector('[data-footer-mark]');
  if (mark && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.fromTo(
      mark,
      { yPercent: 60, opacity: 0.1 },
      { yPercent: 0, opacity: 1, ease: 'none', scrollTrigger: { trigger: mark, start: 'top bottom', end: 'bottom bottom', scrub: true } },
    );
  }
</script>
