---
import { process } from '../../data/site';
---

<section class="relative overflow-hidden border-t border-white/10 bg-ink-2 py-28 md:py-40" data-draw-trigger>
  <div class="grid-bg pointer-events-none absolute inset-0 opacity-50"></div>
  <div class="wrap relative">
    <div class="mb-20 grid gap-8 md:grid-cols-12">
      <div class="md:col-span-7">
        <p class="eyebrow eyebrow-dot mb-5">How CALTEC works</p>
        <h2 class="text-huge font-medium leading-[0.95] tracking-[-0.045em]" data-split="lines">
          From requirement to a <span class="serif-i text-paper/60">usable record.</span>
        </h2>
      </div>
      <div class="self-end md:col-span-4 md:col-start-9" data-reveal>
        <p class="text-lg leading-relaxed text-paper/60">A visible four-stage workflow keeps scope, timing and documentation easy to follow — for your engineers and your auditors.</p>
        <a href="/enquiry/" class="btn btn-ghost mt-6" data-magnetic>Start a service request</a>
      </div>
    </div>

    <div class="relative">
      <!-- Signal trace that draws itself as you scroll -->
      <svg class="pointer-events-none absolute -top-10 left-0 hidden h-24 w-full md:block" viewBox="0 0 1200 100" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 60 H180 L200 20 L220 90 L240 60 H480 L500 25 L520 85 L540 60 H780 L800 20 L820 90 L840 60 H1200" fill="none" stroke="rgb(255 255 255 / .12)" stroke-width="1.5" />
        <path data-draw d="M0 60 H180 L200 20 L220 90 L240 60 H480 L500 25 L520 85 L540 60 H780 L800 20 L820 90 L840 60 H1200" fill="none" stroke="#e4262c" stroke-width="2" />
      </svg>

      <ol class="grid gap-px overflow-hidden rounded-3xl border border-white/10 bg-white/10 md:mt-20 md:grid-cols-4" data-stagger="0.12">
        {
          process.map((p) => (
            <li class="group relative flex min-h-[300px] flex-col justify-between bg-ink-2 p-7 transition-colors duration-700 hover:bg-ink-3">
              <div class="flex items-center justify-between">
                <span class="font-mono text-5xl font-light tabular-nums text-paper/20 transition-colors duration-700 group-hover:text-signal">{p.n}</span>
                <span class="h-2 w-2 rounded-full bg-white/20 transition-colors group-hover:bg-signal" />
              </div>
              <div>
                <h3 class="text-2xl font-medium tracking-tight">{p.title}</h3>
                <p class="mt-3 text-[15px] leading-relaxed text-paper/60">{p.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
