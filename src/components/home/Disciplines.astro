---
import { services } from '../../data/site';
import Icon from '../Icon.astro';
---

<section id="disciplines" class="relative bg-ink">
  <div data-hscroll class="relative overflow-hidden lg:flex lg:h-[100svh] lg:flex-col">
    <div class="wrap flex flex-col gap-6 pt-24 lg:flex-row lg:items-end lg:justify-between lg:pt-[max(6rem,12vh)]">
      <div>
        <p class="eyebrow eyebrow-dot mb-5">One technical partner</p>
        <h2 class="max-w-[16ch] text-huge font-medium lg:max-w-[24ch] lg:text-[clamp(2.25rem,4.2vw,4.5rem)] leading-[0.95] tracking-[-0.045em]" data-split="lines">
          Every critical measurement, <span class="serif-i text-paper/60">connected.</span>
        </h2>
      </div>
      <div class="flex items-center gap-4 font-mono text-xs text-mute">
        <span data-hs-count>01</span>
        <span class="relative h-px w-40 bg-white/15"><span data-hs-bar class="absolute inset-0 origin-left scale-x-0 bg-signal"></span></span>
        <span>{String(services.length).padStart(2, '0')}</span>
      </div>
    </div>

    <div
      data-hs-track
      class="mt-12 flex gap-5 overflow-x-auto px-5 pb-20 [scrollbar-width:none] sm:px-8 lg:mt-[5vh] lg:min-h-0 lg:flex-1 lg:items-start lg:overflow-visible lg:px-12 lg:pb-[7vh] lg:pt-4"
    >
      {
        services.map((s) => (
          <a
            href={`/${s.slug}/`}
            data-cursor="Explore"
            data-label={s.short}
            data-hs-card
            class="group relative flex h-[440px] w-[82vw] shrink-0 flex-col justify-between overflow-hidden rounded-3xl border border-white/10 bg-ink-2 p-7 transition-colors duration-700 hover:border-white/30 sm:w-[420px] lg:h-full lg:max-h-[560px] lg:min-h-[380px] lg:w-[34vw] lg:max-w-[520px]"
          >
            <img
              src={s.image}
              alt=""
              loading="lazy"
              class="absolute inset-0 h-full w-full scale-110 object-cover opacity-0 transition duration-[1.2s] ease-[var(--ease-out-expo)] group-hover:scale-100 group-hover:opacity-35"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink-2 via-ink-2/60 to-transparent" />
            <div class="relative flex items-start justify-between">
              <span class="font-mono text-xs text-mute">{s.index} / {String(services.length).padStart(2, '0')}</span>
              <span class="grid h-14 w-14 place-items-center rounded-full border border-white/15 text-paper transition duration-700 group-hover:rotate-[20deg] group-hover:border-signal group-hover:bg-signal">
                <Icon name={s.slug} class="h-6 w-6" />
              </span>
            </div>
            <div class="relative">
              <p class="mb-3 font-mono text-[11px] uppercase tracking-[0.18em] text-mute">{s.kicker}</p>
              <h3 class="text-[clamp(2.2rem,3.4vw,3.6rem)] font-medium leading-[0.95] tracking-[-0.04em]">{s.short}</h3>
              <p class="mt-4 max-w-sm text-[15px] leading-relaxed text-paper/60">{s.lede}</p>
              <div class="mt-6 flex items-center justify-between border-t border-white/10 pt-4 text-sm">
                <span class="text-paper/60">{s.instruments.length} instrument types</span>
                <span class="flex items-center gap-2 transition-transform duration-500 group-hover:translate-x-1">
                  View scope
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" /></svg>
                </span>
              </div>
            </div>
          </a>
        ))
      }
      <a
        href="/enquiry/"
        data-cursor="Enquire"
        data-hs-card
        class="group relative flex h-[440px] w-[82vw] shrink-0 flex-col justify-between overflow-hidden rounded-3xl bg-signal p-7 text-white sm:w-[420px] lg:h-full lg:max-h-[560px] lg:min-h-[380px] lg:w-[28vw] lg:max-w-[420px]"
      >
        <span class="font-mono text-xs uppercase tracking-[0.2em] text-white/70">Not sure where to begin?</span>
        <div>
          <p class="text-[clamp(2rem,3vw,3.2rem)] font-medium leading-[0.95] tracking-[-0.04em]">Share your instrument list.</p>
          <p class="mt-4 text-white/80">We will help clarify the right scope.</p>
          <span class="mt-8 inline-grid h-16 w-16 place-items-center rounded-full bg-white text-signal transition-transform duration-700 group-hover:rotate-45">
            <svg width="18" height="18" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3 11 11 3M5 3h6v6" stroke="currentColor" stroke-width="1.5" /></svg>
          </span>
        </div>
      </a>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const section = document.querySelector<HTMLElement>('[data-hscroll]');
  const track = document.querySelector<HTMLElement>('[data-hs-track]');
  const bar = document.querySelector<HTMLElement>('[data-hs-bar]');
  const count = document.querySelector<HTMLElement>('[data-hs-count]');
  const cards = gsap.utils.toArray<HTMLElement>('[data-hs-card]');

  if (section && track && !reduced) {
    const mm = gsap.matchMedia();
    mm.add('(min-width: 1024px)', () => {
      const distance = () => track.scrollWidth - window.innerWidth;
      const tween = gsap.to(track, {
        x: () => -distance(),
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: () => `+=${distance()}`,
          pin: true,
          scrub: 1,
          invalidateOnRefresh: true,
          onUpdate(self) {
            if (bar) gsap.set(bar, { scaleX: self.progress });
            if (count) count.textContent = String(Math.min(cards.length - 1, Math.floor(self.progress * (cards.length - 1)) + 1)).padStart(2, '0');
          },
        },
      });
      // Cards tilt slightly as they travel
      cards.forEach((card) => {
        gsap.fromTo(
          card,
          { rotate: 3, y: 40 },
          {
            rotate: -3,
            y: -20,
            ease: 'none',
            scrollTrigger: { trigger: card, containerAnimation: tween, start: 'left right', end: 'right left', scrub: true },
          },
        );
      });
    });
  }
</script>
