---
import { clients } from '../../data/site';
const half = Math.ceil(clients.length / 2);
const rows = [clients.slice(0, half), clients.slice(half)];
---

<section id="clients" class="relative overflow-hidden bg-paper py-24 text-ink md:py-32">
  <div class="wrap mb-14 grid gap-8 md:grid-cols-12">
    <div class="md:col-span-5">
      <p class="eyebrow eyebrow-dot mb-5 !text-ink/60">Trusted in the field</p>
      <h2 class="text-huge font-medium leading-[0.95] tracking-[-0.045em]" data-split="lines">
        {clients.length}+ teams that <span class="serif-i">cannot afford</span> uncertainty.
      </h2>
    </div>
    <p class="self-end text-lg leading-relaxed text-ink/60 md:col-span-4 md:col-start-9" data-reveal>
      Across pharmaceuticals, textiles, automotive, food, energy, healthcare and other essential industries — from multinationals to local manufacturers.
    </p>
  </div>

  <div class="space-y-4" aria-label="Client logos">
    {
      rows.map((row, r) => (
        <div class="flex overflow-hidden [mask-image:linear-gradient(90deg,transparent,black_8%,black_92%,transparent)]">
          <ul class="flex shrink-0 gap-4 pr-4" data-marquee={r === 1 ? 'reverse' : ''} data-speed="45">
            {[...row, ...row].map((c, i) => (
              <li
                class="group flex h-24 w-48 shrink-0 items-center justify-center rounded-2xl border border-ink/10 bg-white px-6 transition-colors duration-500 hover:border-ink/30 md:h-28 md:w-56"
                aria-hidden={i >= row.length ? 'true' : undefined}
              >
                <img
                  src={c.file}
                  alt={i < row.length ? c.name : ''}
                  loading="lazy"
                  class="max-h-12 max-w-full object-contain opacity-70 grayscale transition duration-500 group-hover:opacity-100 group-hover:grayscale-0 md:max-h-14"
                />
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
