---
interface Props {
  name: string;
  class?: string;
}
const { name, class: cls = 'h-6 w-6' } = Astro.props;
---

<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={cls} aria-hidden="true">
  {
    name === 'pressure-calibration' && (
      <>
        <circle cx="12" cy="13" r="8" />
        <path d="M12 13l4-4M7 13h1M16 13h1M12 8V7M12 21v-2" />
        <path d="M10 3h4" />
      </>
    )
  }
  {
    name === 'temperature-calibration' && (
      <>
        <path d="M10 14.5V5a2 2 0 1 1 4 0v9.5a4 4 0 1 1-4 0Z" />
        <path d="M12 9v7" />
        <path d="M17 6h3M17 9h2M17 12h3" />
      </>
    )
  }
  {
    name === 'electrical-calibration' && (
      <>
        <path d="M13 2 5 13h6l-1 9 8-11h-6l1-9Z" />
      </>
    )
  }
  {
    name === 'mechanical-calibration' && (
      <>
        <path d="M12 3v3M5 9h14l-3 7a3 3 0 0 1-8 0L5 9Z" />
        <path d="M8 21h8M12 16v5" />
        <circle cx="12" cy="6" r="1" />
      </>
    )
  }
  {
    name === 'precision-calibration' && (
      <>
        <path d="M3 17 17 3l4 4L7 21l-4-4Z" />
        <path d="M7 13l2 2M10 10l2 2M13 7l2 2" />
      </>
    )
  }
  {
    name === 'flow-meter-calibration' && (
      <>
        <path d="M2 8c3 0 3 2 6 2s3-2 6-2 3 2 6 2" />
        <path d="M2 14c3 0 3 2 6 2s3-2 6-2 3 2 6 2" />
        <path d="M18 4l3 2-3 2" />
      </>
    )
  }
  {
    name === 'thermal-mapping-validation' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <circle cx="8" cy="8" r="1.2" />
        <circle cx="16" cy="8" r="1.2" />
        <circle cx="12" cy="12" r="1.2" />
        <circle cx="8" cy="16" r="1.2" />
        <circle cx="16" cy="16" r="1.2" />
      </>
    )
  }
  {
    name === 'check' && <path d="M4 12.5 9 17.5 20 6.5" />
  }
  {
    name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />
  }
</svg>
